# PostgreSQL connection string
# Local dev (docker-compose):       postgresql://radius:radius@localhost:5432/radius_crm
# Render/Railway: copy the "External Database URL" they give you.
# IMPORTANT: if the URL starts with "postgres://", change it to "postgresql://"
DATABASE_URL=postgresql://radius:radius@localhost:5432/radius_crm

# Generate a real one for production: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-char-hex-string

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
FRONTEND_URLS=http://localhost:5173,https://your-frontend.vercel.app

# Optional: auto-create this admin account on first startup if no users exist yet.
# Leave blank to instead use the one-time POST /auth/register endpoint (bootstrap mode).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: bank payment details shown on generated invoice PDFs.
# If left blank, the invoice PDF simply omits the "Payment Info" block.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
